# Copie para .env e preencha UMA das opções de modelo abaixo.
# Sem nenhuma chave, o projeto usa o Ollama local (modelo qwen2.5:7b).

# Gemini (plano gratuito): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ollama Cloud (exige créditos): https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# Opcionais
# GEMINI_MODEL=geminei
# OLLAMA_MODEL=modelo
# MAX_TOKENS=4096
# BACKEND_PORT=8001
# BACKEND_URL=http://127.0.0.1:8001

# Django — gere a chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Produção (atrás de HTTPS): DJANGO_DEBUG=false e os domínios reais
# DJANGO_ALLOWED_HOSTS=meudominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meudominio.com
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_LOG_LEVEL=INFO
